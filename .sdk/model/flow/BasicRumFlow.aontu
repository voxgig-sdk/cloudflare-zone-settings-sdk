# BasicRumFlow

main: kit: flow: BasicRumFlow:
{
  entity: "rum",
  kind: "basic",
  name: "BasicRumFlow",
  step: [
    {
      m: {
        zone_id: "zone01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "rum_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "rum_ref01",
        srcdatavar: "rum_ref01_data",
        suffix: "_up0",
        textfield: "value"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-rum_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRumFlow"
}