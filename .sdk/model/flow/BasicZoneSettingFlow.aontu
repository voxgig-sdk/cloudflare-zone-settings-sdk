# BasicZoneSettingFlow

main: kit: flow: BasicZoneSettingFlow:
{
  entity: "zone_setting",
  kind: "basic",
  name: "BasicZoneSettingFlow",
  step: [
    {
      m: {
        zone_id: "zone01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "zone_setting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "zone_setting_ref01",
        srcdatavar: "zone_setting_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-zone_setting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "zone_setting_ref01",
        srcdatavar: "zone_setting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "zone_setting01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-zone_setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicZoneSettingFlow"
}